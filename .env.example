# Copy values into Vercel Project → Settings → Environment Variables.
# Never commit real values. Generate VAPID with: node scripts/generate-vapid.mjs

PUBLIC_SITE_URL=https://rotta-canonica-one-piece.vercel.app

# From a dedicated Supabase project (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_OR_LEGACY_ANON_KEY
SUPABASE_SECRET_KEY=YOUR_SERVICE_ROLE_OR_SECRET_KEY

# Web Push: configure only after creating a dedicated Supabase project and testing on iPhone
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:YOUR_CONTACT_EMAIL@example.com

# Protects Monday cron /api/push/check
CRON_SECRET=

# Enable individually only after the OAuth provider and callbacks are tested.
OAUTH_GOOGLE_ENABLED=false
OAUTH_APPLE_ENABLED=false
